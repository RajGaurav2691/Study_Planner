generator client {

 provider = "prisma-client-js"

}

datasource db {

 provider = "mysql"
 url      = env("DATABASE_URL")

}

model User {

 id        Int      @id @default(autoincrement())
 name      String
 email     String   @unique
 password  String
 subjects  Subject[]

}

model Subject {

 id       Int     @id @default(autoincrement())
 name     String
 userId   Int
 user     User    @relation(fields: [userId], references: [id])
 tasks    Task[]

}

model Task {

 id        Int      @id @default(autoincrement())
 title     String
 status    String
 deadline  DateTime
 subjectId Int
 subject   Subject  @relation(fields: [subjectId], references: [id])

}